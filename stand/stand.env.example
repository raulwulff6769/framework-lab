# Copy to stand/stand.env (chmod 600) and fill in. Never commit stand.env: the key is a secret.
ITLES_API_URL=https://itles.vercel.app
# ITles → «Настройки» → «Ключи шлюзов» → «Создать ключ»; the gateway and the stand use the same key
STAND_KEY=
# shown on the stand page
STAND_HOST_LABEL=VPS
# first start only: deliver N days of history through the trackers' black boxes (0 = start from now)
STAND_HISTORY_DAYS=30
# Teltonika units go to a Traccar server; register their IMEIs in your Traccar account
TRACCAR_HOST=demo.traccar.org
TRACCAR_PORT_TELTONIKA=5027
TRACCAR_WEB=https://demo.traccar.org
# gateway ports (defaults): Galileosky 5034, EGTS 5037, Wialon IPS 5039, NTCB/FLEX 5041, Wialon Retranslator 5090
#PORT_EGTS=5037
