{
  "name": "itles-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ITles: мониторинг моточасов, пробега и местоположения спецтехники (FUCHS, дистрибьюторы, клиенты)",
  "scripts": {
    "dev": "tsx dev/server.ts",
    "build:ui": "vite build",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
